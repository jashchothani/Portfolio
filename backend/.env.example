# ==========================================
# SMTP Email Settings (Nodemailer)
# ==========================================
# Sends notifications to you AND sends a confirmation auto-reply to the visitor!
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=jashthakkar77@gmail.com
# Put your 16-character Google App Password below (without spaces):
SMTP_PASS=
# Destination inbox to receive contact notifications:
CONTACT_TO_EMAIL=jashthakkar77@gmail.com
# From header for the emails sent:
SMTP_FROM="Jash Chothani <jashthakkar77@gmail.com>"

# Optional custom SMTP host (if not using Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional Resend fallback:
# RESEND_API_KEY=

